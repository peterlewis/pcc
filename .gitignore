.DS_Store
.build/
.swiftpm/
*.xcodeproj/
xcuserdata/
DerivedData/
.claude/
PCC.dmg
PCC.app/
PCC.zip

# python
__pycache__/
*.pyc

# node / build output — the site is built by CI (see .github/workflows/pages.yml),
# never committed
node_modules/
web/node_modules/
docs/
web/export/
*.bak.js

# heavy third-party / reference material kept locally, out of the web repo
# (clock4 is mitxela's firmware; design_handoff is Claude Design's export)
clock4*/
design_handoff_precision_clock_companion/
Emulator design files/
*.zip

# design-return / reference bundle, kept local (like design_handoff_precision_clock_companion/)
design_handoff_pcc_return/

# emulator: commit the C/JS source, the runtime clock-fw.* + tzrules.bin, and the conformance suite —
# but NOT the compiler build artifacts, the experiment/debug wasm
# (the 12 MB ZoneDetect map is committed via Git LFS — see .gitattributes)
web/emu/phase1/*.o
web/emu/phase1/*.wasm
web/emu/phase1/conform/*.snap
web/emu/phase1/conform/conform_native

# firmware WASM — compiled from source at build time (web/emu/phase1/build.sh)
web/emu/clock-fw.mjs
web/build-info.json
web/app-manifest.sha256

# pccd release build output (dist.sh regenerates it)
host/pccd/dist/

# local backups (firmware images, per-unit configs) — never commit
backups/
host/pccd/history/
