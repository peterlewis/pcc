# Linux (systemd). Install:
#   sudo cp clock-chrony-bridge.py /usr/local/bin/ && sudo chmod +x /usr/local/bin/clock-chrony-bridge.py
#   sudo cp systemd/clock-chrony-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now clock-chrony-bridge
[Unit]
Description=Precision Clock Mk IV -> chrony SOCK bridge
# chrony must be up first: it creates the SOCK the bridge connects to.
After=chronyd.service
Wants=chronyd.service

[Service]
Type=simple
# --require-pps uses only $PMTXTS (enable `pps = on` on the clock) for the
# lowest, most consistent latency. Drop it to also accept plain RMC.
ExecStart=/usr/local/bin/clock-chrony-bridge.py --sock /var/run/chrony.clock.sock --require-pps
Restart=always
RestartSec=2
# Simplest: run as root (needs to read the serial device and write the chrony
# socket). To run unprivileged instead, use a user in the `dialout` group and
# point chrony's socket somewhere that user can write.
User=root

[Install]
WantedBy=multi-user.target
