<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS (launchd). chrony is not shipped with macOS — install it first:
      brew install chrony      (and disable the built-in timed if it conflicts)
  Install this agent:
      sudo cp clock-chrony-bridge.py /usr/local/bin/ && sudo chmod +x /usr/local/bin/clock-chrony-bridge.py
      sudo cp launchd/is.peterlew.chrony-bridge.plist /Library/LaunchDaemons/
      sudo launchctl load /Library/LaunchDaemons/is.peterlew.chrony-bridge.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>is.peterlew.pcc.chrony-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/usr/local/bin/clock-chrony-bridge.py</string>
        <string>--sock</string>
        <string>/var/run/chrony.clock.sock</string>
        <string>--require-pps</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/clock-chrony-bridge.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/clock-chrony-bridge.log</string>
</dict>
</plist>
