<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- pccd as a LaunchDaemon (root): survives reboots and — because root can always write the
     chrony SOCK socket — is immune to chronyd restarts recreating it with root-only permissions.
     Install:
       sudo make install
       sudo cp is.peterlew.pcc.d.plist /Library/LaunchDaemons/
       sudo launchctl load -w /Library/LaunchDaemons/is.peterlew.pcc.d.plist
     (Stop any user-run ./pccd first — the serial port is exclusive-open.)
     Logs: /var/log/pccd.log

     The -w line below serves the PCC web app from the built docs/ dir, so opening
     http://localhost:4192 gives a fully-local, same-origin app+bridge that works in EVERY
     browser (Safari included) with no mixed-content block. Point it at your checkout's docs/;
     drop the two -w lines to disable app-serving. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>is.peterlew.pcc.d</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/pccd</string>
    <string>-s</string>
    <string>/var/run/chrony.pcc.sock</string>
    <string>-w</string>
    <string>/Users/peter/Developer/ML/Claude/pcc/docs</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/pccd.log</string>
  <key>StandardErrorPath</key><string>/var/log/pccd.log</string>
</dict>
</plist>
